# 复制为 .env 并填入你的 OpenAI 兼容中转配置（.env 已被 gitignore，不会入库）
# base URL 以 /v1 结尾
ARGUS_AI_BASE_URL=https://your-endpoint.example.com/v1
ARGUS_AI_API_KEY=sk-xxxx
ARGUS_AI_MODEL=gpt-4.1-mini

# 可选：上下文窗口与最大输出 token
# ARGUS_AI_CONTEXT_WINDOW=128000
# ARGUS_AI_MAX_TOKENS=8192

# 可选：按角色覆盖模型（模型分层预留，不填则统一用 ARGUS_AI_MODEL）
# ARGUS_ANALYST_MODEL=
# ARGUS_EDITOR_MODEL=
